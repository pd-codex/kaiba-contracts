{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaiba:contracts:0.5.0-draft.1:dns-workload-authorization",
  "title": "Transient DNSWorkloadAuthorization response; not a bearer grant",
  "type": "object",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "dnsName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?![\\s\\S])"
    }
  },
  "properties": {
    "contract": { "const": "DNSWorkloadAuthorization" },
    "contract_version": { "const": "0.5.0-draft.1" },
    "request_id": { "type": "string", "pattern": "^[0-9a-f]{32}(?![\\s\\S])" },
    "spiffe_id": { "type": "string", "format": "uri", "maxLength": 482 },
    "logical_device_id": { "$ref": "urn:kaiba:contracts:0.5.0-draft.1:workload-binding#/$defs/segment" },
    "instance_id": { "$ref": "urn:kaiba:contracts:0.5.0-draft.1:workload-binding#/$defs/segment" },
    "dns_device_id": { "type": "string", "minLength": 3, "maxLength": 60, "pattern": "^[0-9]{3,60}(?![\\s\\S])" },
    "hostname": { "$ref": "urn:kaiba:contracts:0.5.0-draft.1:dns-workload-authorization#/$defs/dnsName" },
    "permission": { "const": "dns:update" },
    "checked_at": { "$ref": "urn:kaiba:contracts:0.5.0-draft.1:dns-workload-authorization#/$defs/timestamp" },
    "expires_at": { "$ref": "urn:kaiba:contracts:0.5.0-draft.1:dns-workload-authorization#/$defs/timestamp" }
  },
  "required": [
    "contract", "contract_version", "request_id", "spiffe_id",
    "logical_device_id", "instance_id", "dns_device_id", "hostname",
    "permission", "checked_at", "expires_at"
  ],
  "additionalProperties": false
}
