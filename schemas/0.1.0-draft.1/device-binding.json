{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaiba:contracts:0.1.0-draft.1:device-binding",
  "type": "object",
  "properties": {
    "contract": {
      "const": "DeviceBinding"
    },
    "contract_version": {
      "const": "0.1.0-draft.1"
    },
    "record_id": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
    },
    "revision": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/revision"
    },
    "issued_at": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/timestamp"
    },
    "authority_id": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
    },
    "tenant_id": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
    },
    "security_domain_id": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
    },
    "correlation_id": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
    },
    "logical_device_id": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
    },
    "instance_id": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
    },
    "storage_generation": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/generation"
    },
    "bootstrap_identity_ref": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/evidenceRef"
    },
    "provisioning_ref": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/recordRef"
    },
    "credential": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
        },
        "role": {
          "enum": [
            "outbound_management",
            "inbound_service",
            "bootstrap",
            "attestation"
          ]
        },
        "key_generation": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/generation"
        },
        "spki_digest": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/digest"
        },
        "issuer_id": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/id"
        },
        "certificate_serial": {
          "type": "string",
          "pattern": "^[1-9a-f][0-9a-f]{0,39}$"
        },
        "not_before": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/timestamp"
        },
        "not_after": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/timestamp"
        }
      },
      "required": [
        "slot",
        "role",
        "key_generation",
        "spki_digest",
        "issuer_id",
        "certificate_serial",
        "not_before",
        "not_after"
      ],
      "additionalProperties": false
    },
    "state": {
      "enum": [
        "staged",
        "active",
        "superseded",
        "quarantined",
        "revoked",
        "retired"
      ]
    },
    "activation": {
      "type": "object",
      "properties": {
        "activated_at": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/timestamp"
        },
        "verifier_receipt_ref": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/evidenceRef"
        },
        "policy_ref": {
          "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/evidenceRef"
        }
      },
      "required": [
        "activated_at",
        "verifier_receipt_ref",
        "policy_ref"
      ],
      "additionalProperties": false
    },
    "supersedes": {
      "$ref": "urn:kaiba:contracts:0.1.0-draft.1:common#/$defs/recordRef"
    }
  },
  "required": [
    "contract",
    "contract_version",
    "record_id",
    "revision",
    "issued_at",
    "authority_id",
    "tenant_id",
    "security_domain_id",
    "correlation_id",
    "logical_device_id",
    "instance_id",
    "storage_generation",
    "bootstrap_identity_ref",
    "provisioning_ref",
    "credential",
    "state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "active"
          }
        }
      },
      "then": {
        "required": [
          "activation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "staged"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "activation"
          ]
        }
      }
    }
  ]
}
