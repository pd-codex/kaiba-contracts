{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaiba:contracts:0.6.0-draft.1:pilot-renewal-delegation",
  "type": "object",
  "properties": {
    "record_id": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
    },
    "authority_id": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
    },
    "tenant_id": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
    },
    "security_domain_id": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
    },
    "correlation_id": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
    },
    "revision": {
      "enum": [
        1,
        2
      ]
    },
    "issued_at": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/timestamp"
    },
    "contract": {
      "const": "PilotRenewalDelegation"
    },
    "contract_version": {
      "const": "0.6.0-draft.1"
    },
    "owner_principal": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
    },
    "automation_principal": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
    },
    "owner_approval_ref": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/evidenceRef"
    },
    "mode": {
      "const": "same_key_unexpired"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enrollment_id": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
          },
          "logical_device_id": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
          },
          "instance_id": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
          },
          "credential_slot": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
          },
          "issuer_id": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
          },
          "audience": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/id"
          },
          "target": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/pilotTarget"
          },
          "storage_generation": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/generation"
          },
          "key_generation": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/generation"
          },
          "spki_digest": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/digest"
          },
          "profile": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/pilotProfile"
          },
          "permissions": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/pilotPermissions"
          },
          "accepted_gaps": {
            "type": "array",
            "items": {
              "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/faCondition"
            },
            "uniqueItems": true,
            "maxItems": 8
          },
          "qualification_policy_ref": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/evidenceRef"
          },
          "evidence_scope_digest": {
            "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/digest"
          },
          "max_observation_age_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 604800
          }
        },
        "required": [
          "enrollment_id",
          "logical_device_id",
          "instance_id",
          "credential_slot",
          "issuer_id",
          "audience",
          "target",
          "storage_generation",
          "key_generation",
          "spki_digest",
          "profile",
          "permissions",
          "accepted_gaps",
          "qualification_policy_ref",
          "evidence_scope_digest",
          "max_observation_age_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "activated_at": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/timestamp"
    },
    "max_renewal_seconds": {
      "const": 604800
    },
    "state": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "full_qualification": {
      "const": false
    },
    "revoked_at": {
      "$ref": "urn:kaiba:contracts:0.2.0-draft.1:common#/$defs/timestamp"
    },
    "revocation_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "record_id",
    "authority_id",
    "tenant_id",
    "security_domain_id",
    "correlation_id",
    "revision",
    "issued_at",
    "contract",
    "contract_version",
    "owner_principal",
    "automation_principal",
    "owner_approval_ref",
    "mode",
    "members",
    "activated_at",
    "expires_at",
    "max_renewal_seconds",
    "state",
    "full_qualification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "revoked"
          }
        }
      },
      "then": {
        "required": [
          "revoked_at",
          "revocation_reason"
        ],
        "properties": {
          "revision": {
            "const": 2
          }
        }
      },
      "else": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "revoked_at"
              ]
            },
            {
              "required": [
                "revocation_reason"
              ]
            }
          ]
        }
      }
    }
  ]
}
