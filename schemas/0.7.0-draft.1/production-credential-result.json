{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaiba:contracts:0.7.0-draft.1:production-credential-result",
  "type": "object",
  "properties": {
    "contract": {
      "const": "ProductionCredentialResult"
    },
    "contract_version": {
      "const": "0.7.0-draft.1"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "logical_device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "credential_slot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "storage_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "key_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "spki_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "authority_id",
        "tenant_id",
        "logical_device_id",
        "instance_id",
        "profile_id",
        "credential_slot",
        "storage_generation",
        "key_generation",
        "spki_digest"
      ],
      "additionalProperties": false
    },
    "challenge_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "certificate_der": {
      "type": "string",
      "minLength": 1,
      "maxLength": 21848
    }
  },
  "required": [
    "contract",
    "contract_version",
    "operation_id",
    "identity",
    "challenge_digest",
    "certificate_der"
  ],
  "additionalProperties": false
}
